rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isMaster() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'member') in ['junta', 'lideranca', 'master', 'dev'];
    }
    match /users/{userId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.role == "member";
      allow update: if request.auth != null && (
                      (request.auth.uid == userId && request.resource.data.get('role', 'member') == resource.data.get('role', 'member'))
                      || isMaster()
                    );
      allow delete: if false;
    }
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.authorUid;
    }
    match /stories/{storyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.authorUid;
    }
    match /shorts/{shortId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.authorUid;
    }
    match /chats/{chatId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null && request.auth.uid in resource.data.participants;
      allow delete: if false;
      match /messages/{messageId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
          request.resource.data.senderUid == request.auth.uid;
        allow update: if false;
        allow delete: if request.auth != null && request.auth.uid == resource.data.senderUid;
      }
    }
    match /connections/{connectionId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.fromUid == request.auth.uid
                    && request.resource.data.status == "pending";
      allow update: if request.auth != null && request.auth.uid in resource.data.participants
                    && request.resource.data.status == "accepted";
      allow delete: if request.auth != null && request.auth.uid in resource.data.participants
                    && resource.data.status == "pending";
    }
    match /notifications/{notificationId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.toUid;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == resource.data.toUid;
      allow delete: if false;
    }
    match /storeProducts/{productId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
                      request.auth.uid == resource.data.authorUid
                      || isMaster()
                      || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
                    );
      allow delete: if request.auth != null && request.auth.uid == resource.data.authorUid;
    }
    match /cantinaProducts/{productId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
                      request.auth.uid == resource.data.authorUid
                      || isMaster()
                      || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
                    );
      allow delete: if request.auth != null && request.auth.uid == resource.data.authorUid;
    }
    match /pedidos/{pedidoId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.buyerUid || isMaster());
      allow create: if request.auth != null && request.resource.data.buyerUid == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }
    match /presencas/{presencaId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }
    match /studyRooms/{roomId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /studySignals/{signalId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null && request.auth.uid in resource.data.participants;
      allow delete: if request.auth != null && request.auth.uid in resource.data.participants;
    }
    match /grGroups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
    match /fundamentosGroups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
    match /ministries/{ministryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }
    match /discipuladoTree/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }
    match /kids/{kidId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.parentUid || isMaster());
      allow create: if request.auth != null && request.auth.uid == request.resource.data.parentUid;
      allow update: if request.auth != null && (request.auth.uid == resource.data.parentUid || isMaster());
      allow delete: if request.auth != null && request.auth.uid == resource.data.parentUid;
    }
    match /novosConvertidos/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
                      request.auth.uid == resource.data.registradoPorUid
                      || request.auth.uid == resource.data.discipuladorUid
                      || isMaster()
                    );
      allow delete: if request.auth != null && (request.auth.uid == resource.data.registradoPorUid || isMaster());
    }
    match /oracoes/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.authorUid;
    }
    match /testemunhos/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.authorUid;
    }
    match /negocios/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.authorUid;
    }
    match /mensagens/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (request.auth.uid == resource.data.addedByUid || isMaster());
      allow delete: if request.auth != null && request.auth.uid == resource.data.addedByUid;
      match /notas/{uid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
    match /eventos/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.authorUid;
    }
    match /enquetes/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.authorUid;
    }
    match /escalas/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.createdByUid;
    }
    match /evangelismoEventos/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.createdByUid;
    }
    match /evangelismoFamilias/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.createdByUid;
    }
    match /evangelismoDoacoes/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == resource.data.createdByUid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.createdByUid;
    }
    match /chatGroups/{groupId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null && request.auth.uid in resource.data.participants;
      allow delete: if false;
      match /messages/{messageId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/chatGroups/$(groupId)).data.participants;
        allow create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/chatGroups/$(groupId)).data.participants &&
          request.resource.data.senderUid == request.auth.uid;
        allow update: if false;
        allow delete: if request.auth != null && request.auth.uid == resource.data.senderUid;
      }
    }
  }
}
